# Copy this file to .env.local (and .env for Prisma) and fill in real values.

# Postgres connection string (e.g. from https://neon.tech) — used for both
# local dev and production, so this should be the same value everywhere.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Stripe — get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# The public URL of the site (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Simple shared password that protects /admin
ADMIN_PASSWORD="change-me"

# --- Customer sign-in with Google (optional — the "Sign in" link stays hidden until all 3 are set)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type "Web application"). Authorized redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Any long random string; signs the login cookie. Changing it signs everyone out.
SESSION_SECRET=""
