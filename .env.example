# Copy this file to .env.local (and .env for Prisma) and fill in real values.

# Local dev database (SQLite file). For production, use a real Postgres
# connection string (e.g. from Neon or Vercel Postgres) and change the
# `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Stripe — get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# The public URL of the site (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Simple shared password that protects /admin
ADMIN_PASSWORD="change-me"
