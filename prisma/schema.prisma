// Bear Creek Plant Company — database schema
// Uses Postgres (Neon) for both local dev and production — see README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String
  priceCents  Int
  size        String
  imageUrl    String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model PickupDate {
  id       String   @id @default(cuid())
  date     DateTime @unique
  capacity Int      @default(50)
  isOpen   Boolean  @default(true)
}

model Order {
  id              String   @id @default(cuid())
  customerName    String
  email           String
  phone           String
  pickupDate      DateTime
  notes           String?
  status          String   @default("pending_payment") // pending_payment, paid, ready, picked_up, cancelled
  stripeSessionId String?  @unique
  totalCents      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  name       String
  quantity   Int
  priceCents Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}
